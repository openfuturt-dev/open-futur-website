# Turso (SQLite) database — get these from the Vercel project's Storage tab
# or from the Turso dashboard (turso.tech)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Random secret used to sign admin session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Initial admin account credentials, used by `npx tsx scripts/seed.ts`
ADMIN_EMAIL=
ADMIN_PASSWORD=
